              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/octet-stream"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lang\": \"<string>\",\n  \"type\": \"<string>\",\n  \"codegenVersion\": \"V3\",\n  \"spec\": {\n    \"key_0\": true\n  },\n  \"specURL\": \"<uri>\",\n  \"options\": {\n    \"packageName\": \"<string>\",\n    \"packageVersion\": \"<string>\",\n    \"groupId\": \"<string>\",\n    \"artifactId\": \"<string>\",\n    \"artifactVersion\": \"<string>\",\n    \"sourceFolder\": \"<string>\",\n    \"modelPackage\": \"<string>\",\n    \"apiPackage\": \"<string>\",\n    \"invokerPackage\": \"<string>\",\n    \"httpUserAgent\": \"<string>\",\n    \"gitUserId\": \"<string>\",\n    \"gitRepoId\": \"<string>\",\n    \"hideGenerationTimestamp\": \"<boolean>\",\n    \"dateLibrary\": \"<string>\",\n    \"useRxJS6\": \"<boolean>\",\n    \"npmName\": \"<string>\",\n    \"npmVersion\": \"<string>\",\n    \"npmRepository\": \"<string>\",\n    \"withSeparateModelsAndApi\": \"<boolean>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "1665b9ae-6616-47c3-be6f-804684728c93",
