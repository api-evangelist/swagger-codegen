          "name": "Generate Code From Spec",
          "request": {
            "name": "Generate Code From Spec",
            "description": {
              "content": "Generate a client SDK, server stub, or documentation package from an OpenAPI specification provided in the request body. Returns the generated artifact as a binary ZIP file.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "generate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
